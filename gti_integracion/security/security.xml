<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--region Permisos Cajero -->
        <record id="cajero" model="ir.module.category">
            <field name="name">Cajero</field>
            <field name="sequence">9</field>
        </record>
        <!--Privilegios-->
        <record id="cajero_privilegios" model="res.groups.privilege">
            <field name="name">Privilegios Cajero</field>
            <field name="category_id" ref="cajero"/>
        </record>
        <record id="cajero_lectura" model="res.groups">
            <field name="name">Lectura</field>
            <field name="privilege_id" ref="cajero_privilegios"/>
        </record>
        <record id="cajero_escritura" model="res.groups">
            <field name="name">Escritura</field>
            <field name="privilege_id" ref="cajero_privilegios"/>
            <field name="implied_ids" eval="[(4, ref('cajero_lectura'))]"/>
        </record>
        <record id="cajero_creacion" model="res.groups">
            <field name="name">Creación</field>
            <field name="privilege_id" ref="cajero_privilegios"/>
            <field name="implied_ids" eval="[(4, ref('cajero_escritura'))]"/>
        </record>
        <record id="cajero_eliminacion" model="res.groups">
            <field name="name">Eliminación</field>
            <field name="privilege_id" ref="cajero_privilegios"/>
            <field name="implied_ids" eval="[(4, ref('cajero_creacion'))]"/>
        </record>

